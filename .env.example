# ==============================================================================
# AIAS EDUCATION PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Database Connection
# Replace with your production / managed database connection string (Neon, Supabase, Vercel Postgres, Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aias_db?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secret (Used by Auth.js / JWT sessions)
# Generate a secure 32+ character key: `openssl rand -base64 32`
AUTH_SECRET="aias-super-secure-production-portal-auth-secret-key-32chars"
NEXTAUTH_SECRET="aias-super-secure-production-portal-auth-secret-key-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Initial Super Administrator Credentials (used for initial seeding/setup)
INITIAL_ADMIN_EMAIL="admin@aias.edu.in"
INITIAL_ADMIN_PASSWORD="ChangeMe_AIAS2026!Secure"

# Optional Cloud Services (Configure when ready for production integrations)
# Cloudinary (Media management)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (Transactional emails for admissions notifications)
RESEND_API_KEY=""
ADMISSIONS_NOTIFICATION_EMAIL="admissions@aias.edu.in"

# Sentry (Error monitoring)
NEXT_PUBLIC_SENTRY_DSN=""

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
