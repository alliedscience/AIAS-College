
{
  "name": "aias-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Dedicated Backend Engine and API for AIAS Education Portal",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:emit": "prisma contract emit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma generate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/orm-postgres": "8.0.0-rc.24",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.6",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
