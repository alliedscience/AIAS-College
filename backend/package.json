{
  "name": "aias-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Dedicated Backend Engine and API for AIAS Education Portal",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "db:validate": "prisma7 validate",
    "db:generate": "prisma7 generate",
    "db:emit": "prisma contract emit",
    "db:push": "prisma7 db push",
    "db:migrate": "prisma7 migrate dev",
    "db:seed": "prisma7 generate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/orm-postgres": "8.0.0-rc.24",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/prisma7": "7.10.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.6",
    "prisma": "^8.0.0-rc.34",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
